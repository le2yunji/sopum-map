{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0"
  },
  "scripts": {
    "prepare": "husky",
    "build:frontend": "pnpm --filter @sopum-map/shared build && pnpm --filter frontend build"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3": "3.3.18"
    }
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "pnpm --dir frontend exec eslint --fix --cache --cache-location .next/cache/eslint/.eslintcache"
    ]
  }
}
